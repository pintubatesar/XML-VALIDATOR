@model XML_validator.Models.XmlValidationResultViewModel

@{
    ViewData["Title"] = "Validation Result";
}

<div class="validator-shell">
    <div class="card shadow-sm validator-card">
        <div class="card-body p-4">
            @if (Model.IsValid)
            {
                <div class="alert alert-success mb-0">
                    No validation errors were found. The XML file is valid.
                </div>
            }
            else
            {
                <div class="alert alert-danger">
                    Validation errors were found in the XML file.
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-bordered align-middle validator-table">
                        <thead class="table-light">
                            <tr>
                                <th>XML Element</th>
                                <th>Type</th>
                                <th>Line</th>
                                <th>Column</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var message in Model.Messages)
                            {
                                <tr>
                                    <td>@message.ElementName</td>
                                    <td>@message.Severity</td>
                                    <td>@message.LineNumber</td>
                                    <td>@message.ColumnNumber</td>
                                    <td>@message.Message</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="mt-3">
                <a asp-action="Index" class="btn btn-outline-primary">Validate another file</a>
            </div>
        </div>
    </div>
</div>